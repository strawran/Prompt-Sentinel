# Copy values into your shell environment. Do not commit real keys.
PROMPT_SENTINEL_CONFIG=config.yaml
PROMPT_SENTINEL_AUDIT_DB=data/audit.db
PROMPT_SENTINEL_AUDIT_TOKEN=replace-with-a-random-local-token
PROMPT_SENTINEL_API_URL=http://127.0.0.1:8000
UPSTREAM_PROVIDER=ollama
UPSTREAM_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
# After the embedding model has downloaded once, uncomment for offline startup:
# HF_HUB_OFFLINE=1
# For DeepSeek instead: UPSTREAM_PROVIDER=deepseek and set DEEPSEEK_API_KEY.
# DEEPSEEK_API_KEY=
